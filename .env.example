# ---------------------------------------------------------------
# DelhiDrive — Supabase configuration
# ---------------------------------------------------------------
# 1. Go to https://supabase.com and create a free project
# 2. In your project: Settings (gear icon) > API Keys
# 3. Copy the "Publishable key" — it starts with  sb_publishable_
#    (On older projects this is called the "anon public" key and
#     starts with eyJ... — either one works here.)
# 4. The Project URL is on Settings > Data API, and looks like
#    https://abcdefghijklm.supabase.co
# 5. Rename this file from ".env.example" to ".env"
# 6. Open the SQL Editor in Supabase, paste the whole of
#    supabase-setup.sql, and click Run. That creates every table,
#    the security policies, the storage buckets and the seed data.
# 7. Restart the dev server (Ctrl+C, then: npm run dev)
#
# NEVER put the "Secret key" (sb_secret_...) or the legacy
# "service_role" key in this file. Those bypass all security rules
# and this file is bundled into the browser. The publishable key is
# designed to be public — Row Level Security is what protects your
# data, and supabase-setup.sql sets that up.
# ---------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated list of emails that get admin access to /admin.
# This must match the admin list inside supabase-setup.sql.
VITE_ADMIN_EMAILS=admin@delhidrive.in

# --- integrations ---
# MSG91 phone OTP widget (https://control.msg91.com > OTP > Widget)
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# Google Maps JavaScript API key. RESTRICT IT to your domains in
# Google Cloud Console > Credentials, or it can be scraped and billed to you.
VITE_GOOGLE_MAPS_KEY=

# WhatsApp number that receives booking summaries (country code, digits only)
VITE_WHATSAPP_NUMBER=919911205522
